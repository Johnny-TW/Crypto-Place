{
  "name": "frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.14.0",
  "scripts": {
    "start": "pnpm dev",
    "dev": "vite",
    "dev:local": "vite --mode local",
    "dev:docker": "echo '使用 Docker 開發請執行: docker-compose up'",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{js,jsx,ts,tsx}\" --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,css,scss,json}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css,scss,json}\"",
    "lint:format": "npm run lint:fix && npm run format",
    "type-check": "tsc --noEmit",
    "test:e2e": "echo 'E2E tests not configured yet'",
    "scan": "react-scan",
    "scan:fix": "react-scan --fix",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.{css,scss,json}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@azure/msal-browser": "^4.30.0",
    "@datapunt/matomo-tracker-react": "^0.5.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@headlessui/react": "^2.2.0",
    "@heroicons/react": "^2.2.0",
    "@mui/icons-material": "^5.16.14",
    "@mui/material": "^5.16.14",
    "@mui/x-charts": "^8.11.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/react-table": "^8.21.3",
    "@types/react": "^18.3.18",
    "@vitejs/plugin-react": "^5.0.2",
    "axios": "^1.19.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.3.1",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "js-cookie": "^3.0.7",
    "lodash": "^4.18.0",
    "lucide-react": "^0.513.0",
    "query-string": "^9.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.5.0",
    "react-redux": "^8.1.3",
    "react-router-dom": "^6.28.0",
    "react-scan": "^0.3.6",
    "recharts": "^2.15.4",
    "redux": "^4.2.1",
    "redux-saga": "^1.3.0",
    "sass": "^1.84.0",
    "sweetalert2": "^11.16.0",
    "tailwind-merge": "^3.3.1",
    "vite": "^7.3.6",
    "vitest": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/js-cookie": "^3.0.6",
    "@types/lodash": "^4.17.20",
    "@types/node": "^22.15.30",
    "@vitest/coverage-v8": "^4.1.0",
    "autoprefixer": "^10.4.21",
    "depcheck": "^1.4.7",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.3",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.1.2",
    "postcss": "^8.5.26",
    "prettier": "^3.5.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.46.2"
  },
  "pnpm": {
    "overrides": {
      "esbuild": ">=0.28.1",
      "@babel/runtime@<7.26.10": ">=7.26.10",
      "@babel/helpers@<7.26.10": ">=7.26.10",
      "sweetalert2@>=11.6.14 <11.22.4": ">=11.22.4",
      "picomatch@<2.3.2": "2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4",
      "brace-expansion@1": ">=1.1.17 <2.0.0",
      "brace-expansion@2": ">=2.1.3 <3.0.0",
      "brace-expansion@5": ">=5.0.8 <6.0.0",
      "js-yaml@3": ">=3.15.0 <4.0.0",
      "js-yaml@4": ">=4.3.0 <5.0.0",
      "immutable@5": ">=5.1.8 <6.0.0",
      "postcss@8": ">=8.5.23 <9.0.0",
      "ws@8": ">=8.21.0 <9.0.0",
      "nanoid@3": ">=3.3.18 <4.0.0"
    }
  }
}
