{
  "name": "frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.14.0",
  "scripts": {
    "start": "pnpm dev",
    "dev": "vite",
    "dev:local": "vite --mode local",
    "dev:docker": "echo '使用 Docker 開發請執行: docker-compose up'",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{js,jsx,ts,tsx}\" --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,css,scss,json}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css,scss,json}\"",
    "lint:format": "npm run lint:fix && npm run format",
    "type-check": "tsc --noEmit",
    "test:e2e": "echo 'E2E tests not configured yet'",
    "scan": "react-scan",
    "scan:fix": "react-scan --fix",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.{css,scss,json}": [
      "prettier --write"
    ]
  },
